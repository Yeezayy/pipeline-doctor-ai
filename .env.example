# Explicit simulated data; set false for the real GitLab + LLM integration.
DEMO_MODE=true
# "gitlab" enables per-user OAuth and requires DEMO_MODE=false.
AUTH_MODE=local
PUBLIC_APP_URL=http://localhost:8080
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Public local OAuth uses PKCE, no client secret. See compose.local.yaml.
GITLAB_OAUTH_PUBLIC=false
OAUTH_KEY_FILE=.local/oauth.key
# Generate once with Fernet; keep stable, private and backed up with the database.
TOKEN_ENCRYPTION_KEY=
SESSION_DAYS=7
DATABASE_URL=postgresql+psycopg://doctor:doctor@db:5432/doctor
POSTGRES_DB=doctor
POSTGRES_USER=doctor
POSTGRES_PASSWORD=doctor
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
# Optional numeric project ID or namespace/project path to connect at startup.
GITLAB_PROJECT_ID=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# json_schema (native strict output) or prompt_json (plain JSON + local validation).
LLM_OUTPUT_MODE=json_schema
# Optional local API protection. Enter the same value in the browser Settings.
APP_API_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RETENTION_DAYS=30
LOG_MAX_CHARS=16000
# Optional loopback host port; frontend proxy remains unchanged.
BACKEND_PORT=8000
